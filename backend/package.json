{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "build:compile": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile backend ./src/index.ts",
    "build": "bun build --minify-whitespace --minify-syntax --target node --outfile ./dist/index.js ./src/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@trpc/server": "^11.5.0",
    "add": "^2.0.6",
    "bun": "^1.2.21",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  }
}
