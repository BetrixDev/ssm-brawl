{
	"name": "bot",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/src/index.js"
	},
	"devDependencies": {
		"tsc-alias": "^1.8.11",
		"typescript": "^5.8.2",
		"@types/bun": "^1.2.6"
	}
}
