{
  "name": "@ssmbrawl/backend",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check-types": "tsc -b",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts ",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx @better-auth/cli@latest generate",
    "dev": "bun run --env-file=../../.env.development --watch src/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@libsql/client": "^0.15.15",
    "@orpc/client": "^1.9.1",
    "@orpc/openapi": "^1.9.1",
    "@orpc/server": "^1.9.1",
    "@orpc/zod": "^1.9.1",
    "@polar-sh/better-auth": "^1.1.4",
    "@polar-sh/sdk": "^0.34.17",
    "better-auth": "^1.3.18",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/node": "^22.18.6",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.5",
    "tsdown": "^0.15.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.2"
  }
}
