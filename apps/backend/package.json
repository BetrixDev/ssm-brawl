    "@orpc/zod": "^1.9.0",
    "@polar-sh/better-auth": "^1.1.3",
    "@polar-sh/sdk": "^0.34.16",
    "better-auth": "^1.3.13",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.8.2",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250822.0",
    "@types/node": "^22.13.11",
    "alchemy": "^0.67.0",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.2",
    "tsdown": "^0.15.1",
