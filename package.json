{
  "name": "super-smash-mobs-brawl",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "dev": "concurrently \"alchemy dev\" \"turbo run dev -F plugin\"",
    "dev:plugin": "turbo run dev -F plugin",
    "dev:ts": "alchemy dev",
    "deploy": "alchemy deploy",
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "alchemy": "^0.67.0",
    "dotenv": "^17.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@9.1.0"
}
