{
  "name": "super-smash-mobs-brawl",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write . && pnpm dlx ktfmt@latest --kotlinlang-style plugin/src",
    "dev": "turbo run dev",
    "dev:plugin": "turbo run dev -F plugin",
    "dev:ts": "turbo run dev -F !plugin",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "2.5.9-canary.3"
  },
  "packageManager": "pnpm@9.1.0"
}
