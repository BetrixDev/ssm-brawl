{
  "name": "super-smash-mobs-brawl",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write . && bunx ktfmt@latest --kotlinlang-style plugin/src",
    "dev": "turbo run dev",
    "dev:plugin": "turbo run dev -F plugin",
    "dev:ts": "turbo run dev -F !plugin",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.5.8"
  },
  "workspaces": [
    "apps/*",
    "plugin"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "wiki",
    "workerd"
  ],
  "packageManager": "bun@1.2.22"
}
