{
  "name": "super-smash-mobs-brawl",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugin"
    ],
    "catalog": {
      "convex": "^1.27.0",
      "better-auth": "1.3.27",
      "@convex-dev/better-auth": "^0.9.1",
      "typescript": "^5.7.2"
    }
  },
  "scripts": {
    "format": "prettier --write . && bunx ktfmt@latest --kotlinlang-style plugin/src",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F @ssm-brawl/web dev",
    "dev:server": "turbo -F @ssm-brawl/backend dev",
    "dev:setup": "turbo -F @ssm-brawl/backend dev:setup",
    "dev:!plugin": "turbo -F !@ssm-brawl/plugin dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.0"
}
